generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                           String                        @id @default(uuid())
  name                         String
  email                        String?                       @unique
  phone                        String?
  website                      String?
  address                      String?
  description                  String?
  logoMediaId                  String?
  photoMediaId                 String?
  bannerMediaId                String?
  country                      String?                       @default("GH")
  currency                     String?                       @default("GHS")
  status                       String                        @default("active")
  metadata                     Json?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  defaultLocale                String                        @default("en-GH")
  timeZone                     String                        @default("Africa/Accra")
  entitlement                  AccountEntitlement?
  featureFlags                 AccountFeatureFlag[]
  pricingOverrides             AccountPricingOverride[]
  quotaEvents                  AccountQuotaEvent[]
  AccountRecoveryContact       AccountRecoveryContact[]
  AccountRecoveryRequest       AccountRecoveryRequest[]
  subscription                 AccountSubscription?
  systemSettings               AccountSystemSetting[]
  usageSnapshot                AccountUsageSnapshot?
  apiClients                   ApiClient[]
  apiKeys                      ApiKey[]
  payments                     AppPayment[]
  users                        AppUser[]
  auditLogs                    AuditLog[]
  backgroundJobs               BackgroundJob[]
  BackupConnection             BackupConnection[]
  BackupPolicy                 BackupPolicy[]
  BackupSnapshot               BackupSnapshot[]
  BackupVerification           BackupVerification[]
  billingEvents                BillingEvent[]
  EnterpriseDeployment         EnterpriseDeployment[]
  integrationMappings          IntegrationMapping[]
  invoices                     Invoice[]
  licenseActivations           LicenseActivation[]
  licenseDevices               LicenseDevice[]
  LicenseEntitlementToken      LicenseEntitlementToken[]
  LicenseInstallment           LicenseInstallment[]
  LicensePurchaseAgreement     LicensePurchaseAgreement[]
  licenseUpgradeOffers         LicenseUpgradeOffer[]
  licenseValidationEvents      LicenseValidationEvent[]
  licenseVersionEntitlements   LicenseVersionEntitlement[]
  notificationLogs             NotificationDeliveryLog[]
  paymentEvents                PaymentProviderEvent[]
  permissionRules              PermissionRule[]
  perpetualLicenses            PerpetualLicense[]
  platformAnnouncementReceipts PlatformAnnouncementReceipt[]
  platformFeedback             PlatformFeedback[]
  privateOfferAssignments      PrivateOfferAssignment[]
  RestoreOperation             RestoreOperation[]
  SecurityEvent                SecurityEvent[]
  storageUsage                 StorageUsage?
  subscriptionChanges          SubscriptionChangeOrder[]
  subscriptionPeriods          SubscriptionPeriod[]
  records                      SyncRecord[]
  memberships                  UserMembership[]
  sessions                     UserSession[]
  webhooks                     Webhook[]
  webhookLogs                  WebhookLog[]
  admissionNumberSequences     AdmissionNumberSequence[]
  studentAdmissionIdentities   StudentAdmissionIdentity[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model AppUser {
  id                     String                   @id @default(uuid())
  accountId              String
  fullName               String
  email                  String                   @unique
  phone                  String?
  passwordHash           String
  role                   String                   @default("super_admin")
  active                 Boolean                  @default(true)
  lastLoginAt            DateTime?
  emailVerifiedAt        DateTime?
  phoneVerifiedAt        DateTime?
  passwordChangedAt      DateTime?
  failedLoginCount       Int                      @default(0)
  lockedUntil            DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  preferredLocale        String?
  AccountRecoveryContact AccountRecoveryContact[]
  AccountRecoveryRequest AccountRecoveryRequest[]
  account                Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  EmailVerificationToken EmailVerificationToken[]
  PasswordResetToken     PasswordResetToken[]
  SecurityEvent          SecurityEvent[]
  UserAuthenticator      UserAuthenticator[]
  memberships            UserMembership[]
  UserRecoveryCode       UserRecoveryCode[]
  sessions               UserSession[]
  UserTrustedDevice      UserTrustedDevice[]

  @@index([accountId])
  @@index([email])
  @@index([role])
  @@index([active])
  @@index([lastLoginAt])
}

model UserSession {
  id                    String    @id @default(uuid())
  accountId             String
  userId                String
  refreshTokenHash      String?
  deviceId              String?
  deviceName            String?
  ipAddress             String?
  userAgent             String?
  expiresAt             DateTime
  revokedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  activeMembershipId    String?
  activeRole            String?
  branchId              String?
  lastSeenAt            DateTime?
  schoolId              String?
  authenticationLevel   String?
  lastReauthenticatedAt DateTime?
  riskLevel             String?
  trustedDeviceId       String?
  account               Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user                  AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([userId])
  @@index([activeMembershipId])
  @@index([activeRole])
  @@index([schoolId, branchId])
  @@index([deviceId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([lastSeenAt])
  @@index([riskLevel])
  @@index([trustedDeviceId])
}

model UserMembership {
  id              String    @id @default(uuid())
  accountId       String
  userId          String
  role            String
  schoolId        String?
  branchId        String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  acceptedAt      DateTime?
  createdByUserId String?
  endedAt         DateTime?
  invitedAt       DateTime?
  isDefault       Boolean   @default(false)
  label           String?
  metadata        Json?
  parentId        String?
  scopeKey        String
  status          String    @default("active")
  studentId       String?
  suspendedAt     DateTime?
  teacherId       String?
  preferredLocale String?
  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user            AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, userId, scopeKey])
  @@index([accountId])
  @@index([userId])
  @@index([accountId, role])
  @@index([accountId, schoolId, branchId])
  @@index([teacherId])
  @@index([studentId])
  @@index([parentId])
  @@index([status])
  @@index([active])
  @@index([isDefault])
}

model PermissionRule {
  id          String   @id @default(uuid())
  accountId   String
  moduleKey   String
  moduleLabel String
  owner       String   @default("yes")
  admin       String   @default("no")
  branch      String   @default("no")
  teacher     String   @default("no")
  student     String   @default("no")
  parent      String   @default("no")
  accountant  String   @default("no")
  developer   String   @default("no")
  locked      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, moduleKey])
  @@index([accountId])
  @@index([locked])
}

model SyncRecord {
  id        String   @id @default(uuid())
  accountId String
  tableName String
  localId   String?
  cloudId   String?
  deviceId  String?
  version   Int      @default(1)
  updatedAt BigInt
  isDeleted Boolean  @default(false)
  payload   Json
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, tableName, localId, deviceId])
  @@index([accountId])
  @@index([accountId, tableName])
  @@index([accountId, tableName, updatedAt])
  @@index([accountId, tableName, cloudId])
  @@index([deviceId])
  @@index([cloudId])
  @@index([isDeleted])
}

model SyncDevice {
  id         String    @id @default(uuid())
  accountId  String
  userId     String?
  deviceId   String
  name       String?
  platform   String?
  lastSeenAt DateTime?
  lastPushAt DateTime?
  lastPullAt DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  appBuild   String?
  appVersion String?
  syncPolicy String?

  @@unique([accountId, deviceId])
  @@index([accountId])
  @@index([userId])
  @@index([active])
  @@index([lastSeenAt])
}

model SyncConflict {
  id                String    @id @default(uuid())
  accountId         String
  tableName         String
  localId           String?
  cloudId           String?
  deviceId          String?
  conflictType      String
  status            String    @default("open")
  severity          String    @default("medium")
  serverPayload     Json?
  clientPayload     Json?
  resolutionPayload Json?
  note              String?
  detectedAt        DateTime  @default(now())
  resolvedAt        DateTime?
  resolvedByUserId  String?

  @@index([accountId])
  @@index([accountId, tableName])
  @@index([status])
  @@index([severity])
  @@index([detectedAt])
}

model SubscriptionPlan {
  id                         String                      @id @default(uuid())
  name                       String
  code                       String                      @unique
  description                String?
  currency                   String                      @default("GHS")
  priceMonthly               Int                         @default(0)
  priceYearly                Int                         @default(0)
  maxSchools                 Int?
  maxBranches                Int?
  maxUsers                   Int?
  maxStudents                Int?
  maxTeachers                Int?
  maxStorageMb               Int?
  maxApiCallsPerMonth        Int?
  offlineSync                Boolean                     @default(true)
  cloudBackup                Boolean                     @default(false)
  reports                    Boolean                     @default(true)
  finance                    Boolean                     @default(false)
  parentPortal               Boolean                     @default(false)
  studentPortal              Boolean                     @default(false)
  teacherPortal              Boolean                     @default(true)
  advancedAnalytics          Boolean                     @default(false)
  apiAccess                  Boolean                     @default(false)
  webhooks                   Boolean                     @default(false)
  prioritySupport            Boolean                     @default(false)
  features                   Json?
  active                     Boolean                     @default(true)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  attendance                 Boolean                     @default(false)
  calendarScheduling         Boolean                     @default(false)
  communications             Boolean                     @default(false)
  identityCards              Boolean                     @default(false)
  identitySafety             Boolean                     @default(false)
  metadata                   Json?
  schoolWebsites             Boolean                     @default(false)
  transport                  Boolean                     @default(false)
  priceTermly                Int                         @default(0)
  schemaVersion              Int                         @default(2)
  activationLimit            Int?
  deploymentMode             String                      @default("eleeveon_cloud")
  deviceLimit                Int?
  licenseModel               String                      @default("subscription")
  licensedMajorVersion       Int?
  maximumAppVersion          String?
  minimumAppVersion          String?
  offlineGraceDays           Int?
  priceOneTime               Int?
  requiresPeriodicValidation Boolean                     @default(false)
  syncPolicy                 String                      @default("full")
  updatePolicy               String                      @default("continuous")
  validationIntervalDays     Int?
  availableAcquisitionModes  Json?
  productCode                String                      @default("eleeveon_schools")
  entitlements               AccountEntitlement[]
  pricingOverrides           AccountPricingOverride[]
  subscriptions              AccountSubscription[]       @relation("CurrentSubscriptionPlan")
  scheduledSubscriptions     AccountSubscription[]       @relation("ScheduledSubscriptionPlan")
  licenseUpgradeOffersFrom   LicenseUpgradeOffer[]       @relation("LicenseUpgradeFromPlan")
  licenseUpgradeOffersTo     LicenseUpgradeOffer[]       @relation("LicenseUpgradeToPlan")
  versionEntitlements        LicenseVersionEntitlement[]
  perpetualLicenses          PerpetualLicense[]
  privateOffers              PrivateOffer[]
  changeOrdersFrom           SubscriptionChangeOrder[]   @relation("ChangeOrderFromPlan")
  changeOrdersTo             SubscriptionChangeOrder[]   @relation("ChangeOrderToPlan")
  subscriptionPeriods        SubscriptionPeriod[]

  @@index([code])
  @@index([licenseModel])
  @@index([deploymentMode])
  @@index([syncPolicy])
  @@index([active])
  @@index([schemaVersion])
  @@index([productCode])
}

model AccountSubscription {
  id                    String                    @id @default(uuid())
  accountId             String                    @unique
  planId                String
  status                String                    @default("trial")
  billingCycle          String                    @default("monthly")
  trialStartedAt        DateTime?
  trialEndsAt           DateTime?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  nextBillingDate       DateTime?
  cancelledAt           DateTime?
  cancelReason          String?
  metadata              Json?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  autoRenew             Boolean                   @default(false)
  cancelAtPeriodEnd     Boolean                   @default(false)
  entitlementVersion    Int                       @default(1)
  graceEndsAt           DateTime?
  scheduledBillingCycle String?
  scheduledChangeAt     DateTime?
  scheduledChangeType   String?
  scheduledPlanId       String?
  schemaVersion         Int                       @default(2)
  deploymentMode        String                    @default("eleeveon_cloud")
  syncPolicy            String                    @default("full")
  updatePolicy          String                    @default("continuous")
  entitlement           AccountEntitlement?
  account               Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plan                  SubscriptionPlan          @relation("CurrentSubscriptionPlan", fields: [planId], references: [id])
  scheduledPlan         SubscriptionPlan?         @relation("ScheduledSubscriptionPlan", fields: [scheduledPlanId], references: [id])
  payments              AppPayment[]
  EnterpriseDeployment  EnterpriseDeployment[]
  invoices              Invoice[]
  changeOrders          SubscriptionChangeOrder[]
  periods               SubscriptionPeriod[]

  @@index([planId])
  @@index([scheduledPlanId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@index([nextBillingDate])
  @@index([graceEndsAt])
  @@index([scheduledChangeAt])
  @@index([entitlementVersion])
}

model SubscriptionPeriod {
  id                 String                   @id @default(uuid())
  accountId          String
  subscriptionId     String
  planId             String
  billingCycle       String
  startsAt           DateTime
  endsAt             DateTime
  sourceType         String
  sourceId           String?
  changeOrderId      String?                  @unique
  currency           String                   @default("GHS")
  listAmount         Int                      @default(0)
  amountPaid         Int                      @default(0)
  creditUsed         Int                      @default(0)
  discountAmount     Int                      @default(0)
  status             String                   @default("active")
  calculationVersion Int                      @default(1)
  schemaVersion      Int                      @default(2)
  metadata           Json?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  account            Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  changeOrder        SubscriptionChangeOrder? @relation("ChangeOrderResultingPeriod", fields: [changeOrderId], references: [id])
  plan               SubscriptionPlan         @relation(fields: [planId], references: [id])
  subscription       AccountSubscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, startsAt, endsAt])
  @@index([accountId])
  @@index([subscriptionId])
  @@index([planId])
  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
  @@index([sourceType])
}

model SubscriptionChangeOrder {
  id                 String                  @id @default(uuid())
  accountId          String
  subscriptionId     String?
  fromPlanId         String?
  toPlanId           String
  privateOfferId     String?
  pricingOverrideId  String?
  changeType         String
  billingCycle       String
  effectiveMode      String                  @default("immediate")
  effectiveAt        DateTime
  oldPeriodStart     DateTime?
  oldPeriodEnd       DateTime?
  newPeriodStart     DateTime
  newPeriodEnd       DateTime
  currency           String                  @default("GHS")
  baseAmount         Int
  creditAmount       Int                     @default(0)
  discountAmount     Int                     @default(0)
  taxAmount          Int                     @default(0)
  amountDue          Int
  calculation        Json
  calculationVersion Int                     @default(1)
  status             String                  @default("quoted")
  invoiceId          String?                 @unique
  paymentId          String?                 @unique
  quoteExpiresAt     DateTime
  paidAt             DateTime?
  appliedAt          DateTime?
  cancelledAt        DateTime?
  failureReason      String?
  requestedByUserId  String?
  appliedByUserId    String?
  schemaVersion      Int                     @default(2)
  metadata           Json?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  account            Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fromPlan           SubscriptionPlan?       @relation("ChangeOrderFromPlan", fields: [fromPlanId], references: [id])
  invoice            Invoice?                @relation("ChangeOrderInvoice", fields: [invoiceId], references: [id])
  payment            AppPayment?             @relation("ChangeOrderPayment", fields: [paymentId], references: [id])
  pricingOverride    AccountPricingOverride? @relation(fields: [pricingOverrideId], references: [id])
  privateOffer       PrivateOffer?           @relation(fields: [privateOfferId], references: [id])
  subscription       AccountSubscription?    @relation(fields: [subscriptionId], references: [id])
  toPlan             SubscriptionPlan        @relation("ChangeOrderToPlan", fields: [toPlanId], references: [id])
  resultingPeriod    SubscriptionPeriod?     @relation("ChangeOrderResultingPeriod")

  @@index([accountId])
  @@index([subscriptionId])
  @@index([fromPlanId])
  @@index([toPlanId])
  @@index([changeType])
  @@index([status])
  @@index([effectiveAt])
  @@index([quoteExpiresAt])
  @@index([createdAt])
}

model AccountEntitlement {
  id                  String               @id @default(uuid())
  accountId           String               @unique
  planId              String?
  source              String
  status              String               @default("active")
  validFrom           DateTime?
  validUntil          DateTime?
  graceEndsAt         DateTime?
  maxSchools          Int?
  maxBranches         Int?
  maxUsers            Int?
  maxStudents         Int?
  maxTeachers         Int?
  maxStorageMb        Int?
  maxApiCallsPerMonth Int?
  featureFlags        Json
  limitOverrides      Json?
  sourceDetails       Json?
  metadata            Json?
  version             Int                  @default(1)
  schemaVersion       Int                  @default(1)
  rebuiltAt           DateTime             @default(now())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deploymentMode      String               @default("eleeveon_cloud")
  entitledVersion     String?
  licenseModel        String               @default("subscription")
  perpetualLicenseId  String?              @unique
  subscriptionId      String?              @unique
  syncPolicy          String               @default("full")
  updatePolicy        String               @default("continuous")
  accessMode          String               @default("full")
  productCode         String               @default("eleeveon_schools")
  account             Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  perpetualLicense    PerpetualLicense?    @relation(fields: [perpetualLicenseId], references: [id])
  plan                SubscriptionPlan?    @relation(fields: [planId], references: [id])
  subscription        AccountSubscription? @relation(fields: [subscriptionId], references: [id])

  @@index([planId])
  @@index([subscriptionId])
  @@index([perpetualLicenseId])
  @@index([source])
  @@index([licenseModel])
  @@index([deploymentMode])
  @@index([syncPolicy])
  @@index([status])
  @@index([validUntil])
  @@index([graceEndsAt])
  @@index([version])
  @@index([accessMode])
  @@index([productCode])
}

model AccountUsageSnapshot {
  id                 String   @id @default(uuid())
  accountId          String   @unique
  schools            Int      @default(0)
  branches           Int      @default(0)
  users              Int      @default(0)
  students           Int      @default(0)
  teachers           Int      @default(0)
  storageBytes       BigInt   @default(0)
  storageMb          Int      @default(0)
  apiCallsThisMonth  Int      @default(0)
  entitlementVersion Int      @default(1)
  schemaVersion      Int      @default(2)
  calculatedAt       DateTime @default(now())
  calculationSource  String   @default("reconcile")
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  account            Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([calculatedAt])
  @@index([entitlementVersion])
  @@index([students])
  @@index([storageMb])
}

model PrivateOffer {
  id                      String                    @id @default(uuid())
  code                    String                    @unique
  name                    String
  description             String?
  basePlanId              String
  currency                String                    @default("GHS")
  priceMonthly            Int?
  priceTermly             Int?
  priceYearly             Int?
  discountType            String?
  discountValue           Int?
  featureOverrides        Json?
  limitOverrides          Json?
  validFrom               DateTime?
  validUntil              DateTime?
  maxRedemptions          Int?
  redemptionCount         Int                       @default(0)
  visibleToOwner          Boolean                   @default(false)
  ownerLabel              String?
  active                  Boolean                   @default(true)
  schemaVersion           Int                       @default(2)
  metadata                Json?
  createdByUserId         String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  deploymentModeOverride  String?
  entitledVersionOverride String?
  licenseModelOverride    String?
  priceOneTime            Int?
  syncPolicyOverride      String?
  updatePolicyOverride    String?
  basePlan                SubscriptionPlan          @relation(fields: [basePlanId], references: [id])
  assignments             PrivateOfferAssignment[]
  changeOrders            SubscriptionChangeOrder[]

  @@index([basePlanId])
  @@index([active])
  @@index([validFrom])
  @@index([validUntil])
}

model PrivateOfferAssignment {
  id               String       @id @default(uuid())
  accountId        String
  offerId          String
  status           String       @default("active")
  assignedAt       DateTime     @default(now())
  redeemedAt       DateTime?
  validFrom        DateTime?
  validUntil       DateTime?
  revokedAt        DateTime?
  assignedByUserId String?
  revokedByUserId  String?
  reason           String?
  schemaVersion    Int          @default(2)
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  account          Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  offer            PrivateOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([accountId, offerId])
  @@index([accountId])
  @@index([offerId])
  @@index([status])
  @@index([validUntil])
}

model AccountPricingOverride {
  id                      String                    @id @default(uuid())
  accountId               String
  planId                  String
  currency                String                    @default("GHS")
  priceMonthly            Int?
  priceTermly             Int?
  priceYearly             Int?
  discountType            String?
  discountValue           Int?
  featureOverrides        Json?
  limitOverrides          Json?
  validFrom               DateTime?
  validUntil              DateTime?
  reason                  String?
  active                  Boolean                   @default(true)
  createdByUserId         String?
  updatedByUserId         String?
  schemaVersion           Int                       @default(2)
  metadata                Json?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  deploymentModeOverride  String?
  entitledVersionOverride String?
  licenseModelOverride    String?
  priceOneTime            Int?
  syncPolicyOverride      String?
  updatePolicyOverride    String?
  account                 Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plan                    SubscriptionPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  changeOrders            SubscriptionChangeOrder[]

  @@unique([accountId, planId])
  @@index([accountId])
  @@index([planId])
  @@index([active])
  @@index([validUntil])
}

model AccountQuotaEvent {
  id                 String    @id @default(uuid())
  accountId          String
  resource           String
  eventType          String
  operation          String?
  tableName          String?
  localId            String?
  cloudId            String?
  deviceId           String?
  currentUsage       Int
  limitValue         Int?
  requestedIncrease  Int       @default(0)
  remainingBefore    Int?
  remainingAfter     Int?
  status             String    @default("open")
  message            String?
  details            Json?
  entitlementVersion Int       @default(1)
  schemaVersion      Int       @default(2)
  resolvedAt         DateTime?
  resolvedByUserId   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  account            Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([resource])
  @@index([eventType])
  @@index([status])
  @@index([tableName, localId])
  @@index([deviceId])
  @@index([createdAt])
}

model Invoice {
  id                       String                    @id @default(uuid())
  accountId                String
  subscriptionId           String?
  invoiceNumber            String                    @unique
  currency                 String                    @default("GHS")
  subtotal                 Int
  discount                 Int                       @default(0)
  tax                      Int                       @default(0)
  total                    Int
  amountPaid               Int                       @default(0)
  balance                  Int                       @default(0)
  status                   String                    @default("draft")
  issueDate                DateTime                  @default(now())
  dueDate                  DateTime?
  paidAt                   DateTime?
  note                     String?
  metadata                 Json?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  perpetualLicenseId       String?
  licenseInstallmentId     String?                   @unique
  purchaseAgreementId      String?
  payments                 AppPayment[]
  account                  Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  LicenseInstallment       LicenseInstallment?       @relation(fields: [licenseInstallmentId], references: [id])
  perpetualLicense         PerpetualLicense?         @relation("PerpetualLicenseInvoices", fields: [perpetualLicenseId], references: [id])
  LicensePurchaseAgreement LicensePurchaseAgreement? @relation(fields: [purchaseAgreementId], references: [id])
  subscription             AccountSubscription?      @relation(fields: [subscriptionId], references: [id])
  changeOrder              SubscriptionChangeOrder?  @relation("ChangeOrderInvoice")

  @@index([accountId])
  @@index([subscriptionId])
  @@index([perpetualLicenseId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
  @@index([licenseInstallmentId])
