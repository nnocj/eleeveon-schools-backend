  AppUser           AppUser?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@index([recoveryType])
  @@index([requestedAt])
  @@index([status])
  @@index([userId])
}

model BackupConnection {
  id                   String           @id
  accountId            String
  productCode          String           @default("eleeveon_schools")
  provider             String
  displayName          String?
  externalAccountId    String?
  externalAccountEmail String?
  credentialReference  String?
  status               String           @default("active")
  connectedAt          DateTime         @default(now())
  lastValidatedAt      DateTime?
  disconnectedAt       DateTime?
  lastError            String?
  metadata             Json?
  schemaVersion        Int              @default(1)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime
  Account              Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  BackupPolicy         BackupPolicy[]
  BackupSnapshot       BackupSnapshot[]

  @@index([accountId])
  @@index([lastValidatedAt])
  @@index([productCode])
  @@index([provider])
  @@index([status])
}

model BackupPolicy {
  id                String            @id
  accountId         String
  connectionId      String?
  productCode       String            @default("eleeveon_schools")
  name              String
  enabled           Boolean           @default(true)
  frequency         String            @default("manual")
  retentionCount    Int?
  encryptionEnabled Boolean           @default(true)
  includeMedia      Boolean           @default(true)
  wifiOnly          Boolean           @default(false)
  lastBackupAt      DateTime?
  nextBackupAt      DateTime?
  metadata          Json?
  schemaVersion     Int               @default(1)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime
  Account           Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  BackupConnection  BackupConnection? @relation(fields: [connectionId], references: [id])
  BackupSnapshot    BackupSnapshot[]

  @@index([accountId])
  @@index([connectionId])
  @@index([enabled])
  @@index([frequency])
  @@index([nextBackupAt])
  @@index([productCode])
}

model BackupSnapshot {
  id                 String               @id
  accountId          String
  policyId           String?
  connectionId       String?
  productCode        String               @default("eleeveon_schools")
  backupId           String               @unique
  provider           String
  schoolId           String?
  branchId           String?
  appVersion         String
  schemaVersion      String?
  sizeBytes          BigInt?
  checksum           String?
  storageReference   String?
  status             String               @default("creating")
  createdByDeviceId  String?
  createdByUserId    String?
  startedAt          DateTime             @default(now())
  completedAt        DateTime?
  failedAt           DateTime?
  deletedAt          DateTime?
  error              String?
  metadata           Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  Account            Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  BackupConnection   BackupConnection?    @relation(fields: [connectionId], references: [id])
  BackupPolicy       BackupPolicy?        @relation(fields: [policyId], references: [id])
  BackupVerification BackupVerification[]
  RestoreOperation   RestoreOperation[]

  @@index([accountId])
  @@index([completedAt])
  @@index([connectionId])
  @@index([policyId])
  @@index([productCode])
  @@index([provider])
  @@index([schoolId, branchId])
  @@index([status])
}

model BackupVerification {
  id               String         @id
  accountId        String
  snapshotId       String
  verificationType String         @default("integrity")
  status           String         @default("pending")
  checksumExpected String?
  checksumObserved String?
  verifiedAt       DateTime?
  error            String?
  details          Json?
  createdAt        DateTime       @default(now())
  Account          Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  BackupSnapshot   BackupSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([snapshotId])
  @@index([status])
  @@index([verificationType])
  @@index([verifiedAt])
}

model EmailVerificationToken {
  id        String    @id
  userId    String
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  AppUser   AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
  @@index([userId])
}

model EnterpriseDeployment {
  id                  String               @id
  accountId           String
  perpetualLicenseId  String?
  subscriptionId      String?
  productCode         String               @default("eleeveon_schools")
  deploymentType      String
  environment         String               @default("production")
  apiBaseUrl          String?
  serverInstanceId    String?
  databaseProvider    String?
  region              String?
  apiVersion          String?
  appVersion          String?
  status              String               @default("provisioning")
  lastHeartbeatAt     DateTime?
  activatedAt         DateTime?
  suspendedAt         DateTime?
  retiredAt           DateTime?
  metadata            Json?
  schemaVersion       Int                  @default(1)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime
  Account             Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  PerpetualLicense    PerpetualLicense?    @relation(fields: [perpetualLicenseId], references: [id])
  AccountSubscription AccountSubscription? @relation(fields: [subscriptionId], references: [id])

  @@index([accountId])
  @@index([deploymentType])
  @@index([environment])
  @@index([lastHeartbeatAt])
  @@index([perpetualLicenseId])
  @@index([productCode])
  @@index([status])
  @@index([subscriptionId])
}

model LicenseEntitlementToken {
  id                       String                    @id
  accountId                String
  licenseId                String
  activationId             String?
  agreementId              String?
  tokenId                  String                    @unique
  tokenHash                String?                   @unique
  tokenType                String
  status                   String                    @default("active")
  productCode              String                    @default("eleeveon_schools")
  licensedVersion          String
  majorVersion             Int?
  issuedAt                 DateTime                  @default(now())
  validFrom                DateTime                  @default(now())
  validUntil               DateTime?
  installationId           String?
  supersededAt             DateTime?
  revokedAt                DateTime?
  revokedReason            String?
  claimsSnapshot           Json?
  metadata                 Json?
  schemaVersion            Int                       @default(1)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime
  Account                  Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  LicenseActivation        LicenseActivation?        @relation(fields: [activationId], references: [id])
  LicensePurchaseAgreement LicensePurchaseAgreement? @relation(fields: [agreementId], references: [id])
  PerpetualLicense         PerpetualLicense          @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([activationId])
  @@index([agreementId])
  @@index([installationId])
  @@index([licenseId])
  @@index([status])
  @@index([tokenType])
  @@index([validUntil])
}

model LicenseInstallment {
  id                       String                   @id
  accountId                String
  agreementId              String
  installmentNumber        Int
  currency                 String                   @default("GHS")
  amountDue                Int
  amountPaid               Int                      @default(0)
  dueAt                    DateTime
  paidAt                   DateTime?
  status                   String                   @default("pending")
  graceEndsAt              DateTime?
  note                     String?
  metadata                 Json?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime
  AppPayment               AppPayment[]
  Invoice                  Invoice?
  Account                  Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  LicensePurchaseAgreement LicensePurchaseAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@unique([agreementId, installmentNumber])
  @@index([accountId])
  @@index([agreementId])
  @@index([dueAt])
  @@index([graceEndsAt])
  @@index([status])
}

model LicensePurchaseAgreement {
  id                      String                    @id
  accountId               String
  licenseId               String                    @unique
  purchaseMode            String                    @default("installment")
  currency                String                    @default("GHS")
  cashPrice               Int
  agreementPrice          Int
  depositAmount           Int                       @default(0)
  amountPaid              Int                       @default(0)
  balanceRemaining        Int
  installmentCount        Int?
  installmentsPaid        Int                       @default(0)
  installmentFrequency    String?
  installmentAmount       Int?
  nextPaymentDueAt        DateTime?
  validationIntervalDays  Int?
  graceDays               Int?
  accessModeOnOverdue     String                    @default("restricted")
  status                  String                    @default("pending")
  startedAt               DateTime?
  completedAt             DateTime?
  cancelledAt             DateTime?
  defaultedAt             DateTime?
  createdByUserId         String?
  metadata                Json?
  schemaVersion           Int                       @default(1)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  AppPayment              AppPayment[]
  Invoice                 Invoice[]
  LicenseEntitlementToken LicenseEntitlementToken[]
  LicenseInstallment      LicenseInstallment[]
  Account                 Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  PerpetualLicense        PerpetualLicense          @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([createdAt])
  @@index([licenseId])
  @@index([nextPaymentDueAt])
  @@index([purchaseMode])
  @@index([status])
}

model PasswordResetToken {
  id          String    @id
  userId      String
  email       String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  requestedIp String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  AppUser     AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
  @@index([userId])
}

model ProductReleaseArtifact {
  id                         String          @id
  releaseId                  String
  productCode                String          @default("eleeveon_schools")
  platform                   String
  architecture               String?
  artifactType               String          @default("installer")
  storageKey                 String
  fileName                   String
  fileSizeBytes              BigInt?
  checksumSha256             String
  minimumLicenseMajorVersion Int?
  maximumLicenseMajorVersion Int?
  active                     Boolean         @default(true)
  metadata                   Json?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime
  PlatformRelease            PlatformRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, platform, architecture, artifactType])
  @@index([active])
  @@index([artifactType])
  @@index([platform])
  @@index([productCode])
}

model RestoreOperation {
  id                   String         @id
  accountId            String
  snapshotId           String
  productCode          String         @default("eleeveon_schools")
  targetInstallationId String?
  targetDeviceId       String?
  status               String         @default("pending")
  requestedByUserId    String?
  startedAt            DateTime?
  completedAt          DateTime?
  failedAt             DateTime?
  error                String?
  resultMetadata       Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime
  Account              Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  BackupSnapshot       BackupSnapshot @relation(fields: [snapshotId], references: [id])

  @@index([accountId])
  @@index([createdAt])
  @@index([productCode])
  @@index([snapshotId])
  @@index([status])
  @@index([targetInstallationId])
}

model SecurityEvent {
  id        String   @id
  accountId String?
  userId    String?
  type      String
  severity  String   @default("info")
  outcome   String?
  ipAddress String?
  userAgent String?
  deviceId  String?
  schoolId  String?
  branchId  String?
  message   String?
  details   Json?
  metadata  Json?
  createdAt DateTime @default(now())
  Account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  AppUser   AppUser? @relation(fields: [userId], references: [id])

  @@index([accountId])
  @@index([createdAt])
  @@index([deviceId])
  @@index([outcome])
  @@index([severity])
  @@index([type])
  @@index([userId])
}

model UserAuthenticator {
  id              String    @id
  userId          String
  type            String
  label           String?
  secretEncrypted String?
  credentialId    String?   @unique
  publicKey       Json?
  counter         BigInt?
  transports      Json?
  status          String    @default("active")
  verifiedAt      DateTime?
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  AppUser         AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastUsedAt])
  @@index([status])
  @@index([type])
  @@index([userId])
}

model UserRecoveryCode {
  id        String    @id
  userId    String
  codeHash  String    @unique
  status    String    @default("active")
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  revokedAt DateTime?
  AppUser   AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([usedAt])
  @@index([userId])
}

model UserTrustedDevice {
  id              String    @id
  userId          String
  deviceId        String
  deviceName      String?
  platform        String?
  browser         String?
  fingerprintHash String?
  status          String    @default("trusted")
  trustedAt       DateTime  @default(now())
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  ipAddress       String?
  userAgent       String?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  AppUser         AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([expiresAt])
  @@index([lastUsedAt])
  @@index([status])
  @@index([userId])
}

// ======================================================
// AUTHORITATIVE ADMISSION NUMBERING (SERVER-ONLY)
// ======================================================

model AdmissionNumberSequence {
  id           String   @id @default(uuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  schoolId     String
  branchId     String
  nextSequence Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([accountId, schoolId, branchId])
  @@index([accountId, schoolId])
}

model StudentAdmissionIdentity {
  id               String   @id @default(uuid())
  accountId        String
  account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  schoolId         String
  branchId         String
  studentId        String
  admissionNumber  String
  normalizedNumber String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([accountId, studentId])
  @@unique([accountId, schoolId, branchId, normalizedNumber])
  @@index([accountId, schoolId, branchId])
}

model IdentityCardRegistry {
  id          String                      @id @default(dbgenerated("gen_random_uuid()::text"))
  publicId    String                      @unique @default(dbgenerated("gen_random_uuid()::text"))
  accountId   String
  schoolId    String
  branchId    String
  subjectType String
  subjectId   String
  status      String                      @default("active")
  issuedAt    DateTime                    @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime?                   @db.Timestamptz(3)
  revokedAt   DateTime?                   @db.Timestamptz(3)
  replacedAt  DateTime?                   @db.Timestamptz(3)
  version     Int                         @default(1)
  createdAt   DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                    @updatedAt @db.Timestamptz(3)
  events      IdentityCardRegistryEvent[]

  @@unique([accountId, subjectType, subjectId])
  @@index([schoolId, branchId, subjectType, status])
}

model IdentityCardRegistryEvent {
  id          String               @id @default(dbgenerated("gen_random_uuid()::text"))
  cardId      String
  accountId   String
  eventType   String
  performedBy String?
  occurredAt  DateTime             @default(now()) @db.Timestamptz(3)
  note        String?
  card        IdentityCardRegistry @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, occurredAt])
}

model IdentityIssuancePolicy {
  id                String   @id @default(dbgenerated("gen_random_uuid()::text"))
  accountId         String
  schoolId          String
  branchId          String
  studentMode       String   @default("manual")
  teacherMode       String   @default("manual")
  expiryMonths      Int      @default(12)
  showClassPublicly Boolean  @default(true)
  showNamePublicly  Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  @@unique([accountId, schoolId, branchId])
}

// Eleeveon Center E2EE public device directory. Private keys NEVER leave devices.
// Support messages continue using PlatformFeedbackMessage.body as opaque ciphertext.
model SupportEncryptionDevice {
  id                  String    @id @default(uuid())
  accountId           String
  userId              String
  encryptionPublicJwk Json
  signingPublicJwk    Json
  fingerprint         String
  registeredAt        DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())
  revokedAt           DateTime?
  linkedAt            DateTime?
  linkedByDeviceId    String?
  deviceName          String?

  @@index([accountId, userId])
  @@index([userId, revokedAt])
  @@index([revokedAt])
  @@index([accountId, userId, linkedAt])
}

// Eleeveon Center surveys: structured publishing and one response per invited user.
// Answers are server-accessible for aggregation; do not describe surveys as E2EE.
model EleeveonSurvey {
  id              String                   @id @default(uuid())
  title           String
  description     String?
  questions       Json
  targeting       Json?
  status          String                   @default("draft")
  createdByUserId String
  opensAt         DateTime?
  closesAt        DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  responses       EleeveonSurveyResponse[]

  @@index([status, createdAt])
  @@index([createdByUserId])
}

model EleeveonSurveyResponse {
  id          String         @id @default(uuid())
  surveyId    String
  accountId   String
  userId      String
  branchId    String?
  answers     Json
  submittedAt DateTime       @default(now())
  survey      EleeveonSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([surveyId, userId])
  @@index([surveyId, submittedAt])
  @@index([accountId, submittedAt])
}

// Presence is short lived. No typing or recording content is persisted.
model EleeveonSupportPresence {
  id         String   @id @default(uuid())
  feedbackId String
  userId     String
  accountId  String
  activity   String   @default("online")
  expiresAt  DateTime
  updatedAt  DateTime @updatedAt

  @@unique([feedbackId, userId])
  @@index([feedbackId, expiresAt])
}

// WebRTC signalling metadata. Audio/video/screen pixels never go into PostgreSQL.
model EleeveonSupportSignal {
  id         String   @id @default(uuid())
  feedbackId String
  fromUserId String
  sessionId  String
  kind       String
  payload    Json?
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([feedbackId, createdAt])
  @@index([expiresAt])
}

model EleeveonSupportDirectUpload {
  id            String    @id @default(uuid())
  feedbackId    String
  accountId     String
  userId        String
  messageId     String
  storageKey    String    @unique
  expectedBytes Int
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())
  expiresAt     DateTime

  @@index([feedbackId, userId, messageId])
  @@index([expiresAt])
}
// Hub pairing: public keys only; pairing code is held as an HMAC, never plaintext.
model SupportDeviceLink {
  id                  String             @id @default(uuid())
  accountId           String
  userId              String
  targetDeviceId      String
  codeHash            String
  challenge           String
  deviceName          String?
  status              String             @default("pending")
  attemptCount        Int                @default(0)
  approvedByDeviceId  String?
  approvedAt          DateTime?
  completedAt         DateTime?
  expiresAt           DateTime
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  historyKeys         SupportHistoryKey[]

  @@index([accountId, userId, status])
  @@index([accountId, userId, codeHash, status])
  @@index([userId, targetDeviceId])
  @@index([expiresAt])
}

// Opaque E2EE message-key rewraps, generated and signed on an existing device.
// No plaintext message, attachment key, or private key belongs in this model.
model SupportHistoryKey {
  id                 String             @id @default(uuid())
  linkId             String
  conversationId     String
  messageId          String
  targetDeviceId     String
  sourceDeviceId     String
  wrappedKey         Json
  signature          String
  createdAt          DateTime           @default(now())
  link               SupportDeviceLink  @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([messageId, targetDeviceId])
  @@index([targetDeviceId, conversationId])
  @@index([linkId])
}

// Rate-limits code guessing even when no guessed code corresponds to a link.
model SupportPairingAttempt {
  id        String   @id @default(uuid())
  accountId String
  userId    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Shared user setting across all Eleeveon Hub sections, not one per chat.
model HubUserAppearance {
  userId         String   @id
  accountId      String
  backgroundKind String   @default("default")
  backgroundKey  String?
  updatedAt      DateTime @updatedAt

  @@index([accountId])
}

model HubBackgroundImage {
  id         String   @id @default(uuid())
  userId     String
  accountId  String
  storageKey String   @unique
  name       String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  @@index([accountId, userId])
}
