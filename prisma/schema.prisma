// ======================================================
// prisma/schema.prisma
// ELEEVEON SCHOOLS - FULL DROP-IN PLATFORM-READY SCHEMA
// ======================================================
// Purpose:
// - Keeps your current auth, account, sync, billing and permission models.
// - Adds backend-only platform infrastructure for audit logs, API clients,
//   API keys, webhooks, integration mapping, storage usage, background jobs,
//   notification delivery logs, and payment provider events.
// - Designed to work with an offline-first Dexie app where synced school records
//   use permanent string IDs inside SyncRecord payloads.
// - Adds Platform V2 commercial access: connected subscriptions, offline
//   perpetual licences, entitlements, private offers, pricing overrides,
//   release/update communication, localization preferences and feedback.
// ======================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// ACCOUNT / TENANT
// ======================================================

model Account {
  id    String  @id @default(uuid())
  name  String
  email String? @unique
  phone String?

  // Account-level organization profile and branding.
  // Media fields store references only; image/blob data stays in the app media system.
  website       String?
  address       String?
  description   String?
  logoMediaId   String?
  photoMediaId  String?
  bannerMediaId String?

  country       String?  @default("GH")
  currency      String?  @default("GHS")
  defaultLocale String   @default("en-GH")
  timeZone      String   @default("Africa/Accra")
  status        String   @default("active") // active | suspended | closed
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users           AppUser[]
  memberships     UserMembership[]
  sessions        UserSession[]
  records         SyncRecord[]
  subscription    AccountSubscription?
  billingEvents   BillingEvent[]
  invoices        Invoice[]
  payments        AppPayment[]
  permissionRules PermissionRule[]

  // Platform V2 commercial access and entitlement foundation.
  subscriptionPeriods        SubscriptionPeriod[]
  subscriptionChanges        SubscriptionChangeOrder[]
  perpetualLicenses          PerpetualLicense[]
  licenseActivations         LicenseActivation[]
  licenseDevices             LicenseDevice[]
  licenseVersionEntitlements LicenseVersionEntitlement[]
  licenseUpgradeOffers       LicenseUpgradeOffer[]
  entitlement                AccountEntitlement?
  usageSnapshot              AccountUsageSnapshot?
  privateOfferAssignments    PrivateOfferAssignment[]
  pricingOverrides           AccountPricingOverride[]
  quotaEvents                AccountQuotaEvent[]

  platformAnnouncementReceipts PlatformAnnouncementReceipt[]
  platformFeedback             PlatformFeedback[]

  apiClients              ApiClient[]
  apiKeys                 ApiKey[]
  webhooks                Webhook[]
  webhookLogs             WebhookLog[]
  auditLogs               AuditLog[]
  storageUsage            StorageUsage?
  backgroundJobs          BackgroundJob[]
  integrationMappings     IntegrationMapping[]
  notificationLogs        NotificationDeliveryLog[]
  paymentEvents           PaymentProviderEvent[]
  featureFlags            AccountFeatureFlag[]
  systemSettings          AccountSystemSetting[]
  licenseValidationEvents LicenseValidationEvent[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

// ======================================================
// AUTH USERS
// ======================================================

model AppUser {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  fullName     String
  email        String  @unique
  phone        String?
  passwordHash String

  // Fallback/default role. Keep this so your current app does not break.
  role            String    @default("super_admin") // developer | platform_team | super_admin | school_admin | branch_admin | accountant | teacher | student | parent
  preferredLocale String? // e.g. en-GH | fr-FR; null inherits membership/account
  active          Boolean   @default(true)
  lastLoginAt     DateTime?

  // Optional security/account recovery fields.
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  passwordChangedAt DateTime?
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships UserMembership[]
  sessions    UserSession[]

  @@index([accountId])
  @@index([email])
  @@index([role])
  @@index([active])
  @@index([lastLoginAt])
}

model UserSession {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  userId String
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeMembershipId String?
  activeRole         String?
  schoolId           String?
  branchId           String?

  refreshTokenHash String?
  deviceId         String?
  deviceName       String?
  ipAddress        String?
  userAgent        String?

  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([accountId])
  @@index([userId])
  @@index([activeMembershipId])
  @@index([activeRole])
  @@index([schoolId, branchId])
  @@index([deviceId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([lastSeenAt])
}

model UserMembership {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  userId String
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  role String // developer | platform_team | super_admin | school_admin | branch_admin | accountant | teacher | student | parent

  // Permanent synced string IDs from the frontend database.
  schoolId String?
  branchId String?

  teacherId String?
  studentId String?
  parentId  String?

  // Stable application-generated identity for this membership scope.
  // Example: student:student_uuid or branch_admin:branch_uuid.
  scopeKey String

  status          String  @default("active") // invited | active | suspended | revoked | expired
  active          Boolean @default(true)
  isDefault       Boolean @default(false)
  label           String?
  preferredLocale String? // Highest-priority locale for this workspace membership.
  metadata        Json?

  invitedAt       DateTime?
  acceptedAt      DateTime?
  suspendedAt     DateTime?
  endedAt         DateTime?
  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, userId, scopeKey])
  @@index([accountId])
  @@index([userId])
  @@index([accountId, role])
  @@index([accountId, schoolId, branchId])
  @@index([teacherId])
  @@index([studentId])
  @@index([parentId])
  @@index([status])
  @@index([active])
  @@index([isDefault])
}

model PermissionRule {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  moduleKey   String
  moduleLabel String

  owner      String @default("yes")
  admin      String @default("no")
  branch     String @default("no")
  teacher    String @default("no")
  student    String @default("no")
  parent     String @default("no")
  accountant String @default("no")
  developer  String @default("no")

  locked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, moduleKey])
  @@index([accountId])
  @@index([locked])
}

// ======================================================
// OFFLINE-FIRST SYNC STORAGE
// ======================================================

model SyncRecord {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  tableName String
  localId   String?
  cloudId   String?
  deviceId  String?

  version   Int     @default(1)
  updatedAt BigInt
  isDeleted Boolean @default(false)

  payload Json

  createdAt DateTime @default(now())

  // A stable lookup for pushed local records. This is the safest uniqueness rule
  // for local-first tables where a device may send localId before cloudId exists.
  @@unique([accountId, tableName, localId, deviceId])
  @@index([accountId])
  @@index([accountId, tableName])
  @@index([accountId, tableName, updatedAt])
  @@index([accountId, tableName, cloudId])
  @@index([deviceId])
  @@index([cloudId])
  @@index([isDeleted])
}

model SyncDevice {
  id String @id @default(uuid())

  accountId  String
  userId     String?
  deviceId   String
  name       String?
  platform   String? // web | android | ios | desktop
  appVersion String?
  appBuild   String?

  // Effective network policy last issued to this device.
  syncPolicy String? // full | platform_only | disabled

  lastSeenAt DateTime?
  lastPushAt DateTime?
  lastPullAt DateTime?
  active     Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, deviceId])
  @@index([accountId])
  @@index([userId])
  @@index([active])
  @@index([lastSeenAt])
}

model SyncConflict {
  id String @id @default(uuid())

  accountId String
  tableName String
  localId   String?
  cloudId   String?
  deviceId  String?

  conflictType String // version_conflict | deleted_conflict | validation_error | ownership_mismatch
  status       String @default("open") // open | resolved | ignored
  severity     String @default("medium") // low | medium | high | critical

  serverPayload     Json?
  clientPayload     Json?
  resolutionPayload Json?
  note              String?

  detectedAt       DateTime  @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?

  @@index([accountId])
  @@index([accountId, tableName])
  @@index([status])
  @@index([severity])
  @@index([detectedAt])
}

// ======================================================
// SUBSCRIPTIONS / SAAS BILLING
// ======================================================

model SubscriptionPlan {
  id String @id @default(uuid())

  name        String
  code        String  @unique // trial | starter | standard | premium | enterprise
  description String?

  currency     String @default("GHS")
  priceMonthly Int    @default(0)
  priceTermly  Int    @default(0) // Four-month connected subscription price
  priceYearly  Int    @default(0)
  priceOneTime Int? // Offline perpetual licence price.

  // subscription | perpetual | trial | complimentary
  licenseModel String @default("subscription")

  // connected uses offline-first + cloud sync; offline is local-only school data.
  deploymentMode String @default("connected") // connected | offline
  syncPolicy     String @default("full") // full | platform_only | disabled
  updatePolicy   String @default("continuous") // continuous | security_only | version_locked

  licensedMajorVersion       Int?
  minimumAppVersion          String?
  maximumAppVersion          String?
  deviceLimit                Int?
  activationLimit            Int?
  requiresPeriodicValidation Boolean @default(false)
  validationIntervalDays     Int?
  offlineGraceDays           Int?

  maxSchools          Int?
  maxBranches         Int?
  maxUsers            Int?
  maxStudents         Int?
  maxTeachers         Int?
  maxStorageMb        Int?
  maxApiCallsPerMonth Int?

  // Core platform capabilities.
  offlineSync Boolean @default(true)
  cloudBackup Boolean @default(false)
  reports     Boolean @default(true)
  finance     Boolean @default(false)

  // School operations and identity.
  attendance         Boolean @default(false)
  identityCards      Boolean @default(false)
  identitySafety     Boolean @default(false)
  transport          Boolean @default(false)
  communications     Boolean @default(false)
  calendarScheduling Boolean @default(false)

  // Public digital presence.
  schoolWebsites Boolean @default(false)

  // Role portals and advanced capabilities.
  parentPortal      Boolean @default(false)
  studentPortal     Boolean @default(false)
  teacherPortal     Boolean @default(true)
  advancedAnalytics Boolean @default(false)
  apiAccess         Boolean @default(false)
  webhooks          Boolean @default(false)
  prioritySupport   Boolean @default(false)

  // Extensible capability data.
  // `features` may contain the enabled feature keys.
  // `metadata.featureFlags` may preserve explicit true/false values.
  features Json?
  metadata Json?

  // All newly introduced subscription structures remain at version one.
  schemaVersion Int     @default(2)
  active        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions            AccountSubscription[]       @relation("CurrentSubscriptionPlan")
  scheduledSubscriptions   AccountSubscription[]       @relation("ScheduledSubscriptionPlan")
  subscriptionPeriods      SubscriptionPeriod[]
  changeOrdersFrom         SubscriptionChangeOrder[]   @relation("ChangeOrderFromPlan")
  changeOrdersTo           SubscriptionChangeOrder[]   @relation("ChangeOrderToPlan")
  entitlements             AccountEntitlement[]
  privateOffers            PrivateOffer[]
  pricingOverrides         AccountPricingOverride[]
  perpetualLicenses        PerpetualLicense[]
  versionEntitlements      LicenseVersionEntitlement[]
  licenseUpgradeOffersFrom LicenseUpgradeOffer[]       @relation("LicenseUpgradeFromPlan")
  licenseUpgradeOffersTo   LicenseUpgradeOffer[]       @relation("LicenseUpgradeToPlan")

  @@index([code])
  @@index([licenseModel])
  @@index([deploymentMode])
  @@index([syncPolicy])
  @@index([active])
  @@index([schemaVersion])
}

model AccountSubscription {
  id String @id @default(uuid())

  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  planId String
  plan   SubscriptionPlan @relation("CurrentSubscriptionPlan", fields: [planId], references: [id])

  status         String @default("trial") // trial | pending | active | grace | past_due | expired | cancelled | suspended
  billingCycle   String @default("monthly") // monthly | termly | yearly | manual
  deploymentMode String @default("connected")
  syncPolicy     String @default("full")
  updatePolicy   String @default("continuous")

  trialStartedAt DateTime?
  trialEndsAt    DateTime?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  nextBillingDate    DateTime?

  // Renewal and scheduled-change controls.
  autoRenew         Boolean   @default(false)
  cancelAtPeriodEnd Boolean   @default(false)
  graceEndsAt       DateTime?

  scheduledPlanId       String?
  scheduledPlan         SubscriptionPlan? @relation("ScheduledSubscriptionPlan", fields: [scheduledPlanId], references: [id], onDelete: SetNull)
  scheduledBillingCycle String?
  scheduledChangeAt     DateTime?
  scheduledChangeType   String? // downgrade | renewal | manual_change

  cancelledAt  DateTime?
  cancelReason String?

  // Incremented whenever effective access changes.
  entitlementVersion Int   @default(1)
  schemaVersion      Int   @default(2)
  metadata           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices     Invoice[]
  payments     AppPayment[]
  periods      SubscriptionPeriod[]
  changeOrders SubscriptionChangeOrder[]
  entitlement  AccountEntitlement?

  @@index([planId])
  @@index([scheduledPlanId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@index([nextBillingDate])
  @@index([graceEndsAt])
  @@index([scheduledChangeAt])
  @@index([entitlementVersion])
}

model SubscriptionPeriod {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  subscriptionId String
  subscription   AccountSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  billingCycle String
  startsAt     DateTime
  endsAt       DateTime

  // purchase | renewal | extension | upgrade | downgrade |
  // complimentary | trial | manual_adjustment
  sourceType String
  sourceId   String?

  changeOrderId String?                  @unique
  changeOrder   SubscriptionChangeOrder? @relation("ChangeOrderResultingPeriod", fields: [changeOrderId], references: [id], onDelete: SetNull)

  currency       String @default("GHS")
  listAmount     Int    @default(0)
  amountPaid     Int    @default(0)
  creditUsed     Int    @default(0)
  discountAmount Int    @default(0)

  status String @default("active") // scheduled | active | completed | cancelled | superseded

  calculationVersion Int   @default(1)
  schemaVersion      Int   @default(2)
  metadata           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriptionId, startsAt, endsAt])
  @@index([accountId])
  @@index([subscriptionId])
  @@index([planId])
  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
  @@index([sourceType])
}

model SubscriptionChangeOrder {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   AccountSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  fromPlanId String?
  fromPlan   SubscriptionPlan? @relation("ChangeOrderFromPlan", fields: [fromPlanId], references: [id], onDelete: SetNull)

  toPlanId String
  toPlan   SubscriptionPlan @relation("ChangeOrderToPlan", fields: [toPlanId], references: [id])

  privateOfferId String?
  privateOffer   PrivateOffer? @relation(fields: [privateOfferId], references: [id], onDelete: SetNull)

  pricingOverrideId String?
  pricingOverride   AccountPricingOverride? @relation(fields: [pricingOverrideId], references: [id], onDelete: SetNull)

  // new | renewal | extension | upgrade | downgrade |
  // complimentary | manual_change
  changeType    String
  billingCycle  String
  effectiveMode String   @default("immediate") // immediate | period_end
  effectiveAt   DateTime

  oldPeriodStart DateTime?
  oldPeriodEnd   DateTime?
  newPeriodStart DateTime
  newPeriodEnd   DateTime

  currency       String @default("GHS")
  baseAmount     Int
  creditAmount   Int    @default(0)
  discountAmount Int    @default(0)
  taxAmount      Int    @default(0)
  amountDue      Int

  // Complete server-side quotation breakdown.
  calculation        Json
  calculationVersion Int  @default(1)

  status String @default("quoted")
  // quoted | payment_pending | paid | scheduled | applied |
  // cancelled | expired | failed

  invoiceId String?  @unique
  invoice   Invoice? @relation("ChangeOrderInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)

  paymentId String?     @unique
  payment   AppPayment? @relation("ChangeOrderPayment", fields: [paymentId], references: [id], onDelete: SetNull)

  resultingPeriod SubscriptionPeriod? @relation("ChangeOrderResultingPeriod")

  quoteExpiresAt DateTime
  paidAt         DateTime?
  appliedAt      DateTime?
  cancelledAt    DateTime?
  failureReason  String?

  requestedByUserId String?
  appliedByUserId   String?

  schemaVersion Int   @default(2)
  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([subscriptionId])
  @@index([fromPlanId])
  @@index([toPlanId])
  @@index([changeType])
  @@index([status])
  @@index([effectiveAt])
  @@index([quoteExpiresAt])
  @@index([createdAt])
}

model AccountEntitlement {
  id String @id @default(uuid())

  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  planId String?
  plan   SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  subscriptionId String?              @unique
  subscription   AccountSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  perpetualLicenseId String?           @unique
  perpetualLicense   PerpetualLicense? @relation(fields: [perpetualLicenseId], references: [id], onDelete: SetNull)

  // subscription | perpetual_license | trial | private_offer |
  // pricing_override | complimentary | manual
  source String
  status String @default("active")
  // active | trial | grace | past_due | expired | suspended | cancelled

  validFrom   DateTime?
  validUntil  DateTime?
  graceEndsAt DateTime?

  licenseModel    String  @default("subscription")
  deploymentMode  String  @default("connected") // connected | offline
  syncPolicy      String  @default("full") // full | platform_only | disabled
  updatePolicy    String  @default("continuous") // continuous | security_only | version_locked
  entitledVersion String?

  maxSchools          Int?
  maxBranches         Int?
  maxUsers            Int?
  maxStudents         Int?
  maxTeachers         Int?
  maxStorageMb        Int?
  maxApiCallsPerMonth Int?

  featureFlags   Json
  limitOverrides Json?
  sourceDetails  Json?
  metadata       Json?

  // Starts at one and increases whenever effective access is rebuilt.
  version       Int @default(1)
  schemaVersion Int @default(1)

  rebuiltAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([subscriptionId])
  @@index([perpetualLicenseId])
  @@index([source])
  @@index([licenseModel])
  @@index([deploymentMode])
  @@index([syncPolicy])
  @@index([status])
  @@index([validUntil])
  @@index([graceEndsAt])
  @@index([version])
}

model AccountUsageSnapshot {
  id String @id @default(uuid())

  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  schools  Int @default(0)
  branches Int @default(0)
  users    Int @default(0)
  students Int @default(0)
  teachers Int @default(0)

  storageBytes      BigInt @default(0)
  storageMb         Int    @default(0)
  apiCallsThisMonth Int    @default(0)

  // Mirrors the entitlement version used when this snapshot was calculated.
  entitlementVersion Int @default(1)
  schemaVersion      Int @default(2)

  calculatedAt      DateTime @default(now())
  calculationSource String   @default("reconcile") // reconcile | mutation | sync | manual
  metadata          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([calculatedAt])
  @@index([entitlementVersion])
  @@index([students])
  @@index([storageMb])
}

model PrivateOffer {
  id String @id @default(uuid())

  code        String  @unique
  name        String
  description String?

  basePlanId String
  basePlan   SubscriptionPlan @relation(fields: [basePlanId], references: [id])

  currency     String @default("GHS")
  priceMonthly Int?
  priceTermly  Int?
  priceYearly  Int?
  priceOneTime Int?

  licenseModelOverride    String? // subscription | perpetual
  deploymentModeOverride  String? // connected | offline
  syncPolicyOverride      String? // full | platform_only | disabled
  updatePolicyOverride    String? // continuous | security_only | version_locked
  entitledVersionOverride String?

  discountType  String? // fixed | percentage | free
  discountValue Int?

  featureOverrides Json?
  limitOverrides   Json?

  validFrom  DateTime?
  validUntil DateTime?

  maxRedemptions  Int?
  redemptionCount Int  @default(0)

  // False keeps the internal offer name/details out of ordinary owner portals.
  visibleToOwner Boolean @default(false)
  ownerLabel     String?

  active        Boolean @default(true)
  schemaVersion Int     @default(2)
  metadata      Json?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignments  PrivateOfferAssignment[]
  changeOrders SubscriptionChangeOrder[]

  @@index([basePlanId])
  @@index([active])
  @@index([validFrom])
  @@index([validUntil])
}

model PrivateOfferAssignment {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  offerId String
  offer   PrivateOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  status String @default("active") // assigned | active | redeemed | expired | revoked

  assignedAt DateTime  @default(now())
  redeemedAt DateTime?
  validFrom  DateTime?
  validUntil DateTime?
  revokedAt  DateTime?

  assignedByUserId String?
  revokedByUserId  String?
  reason           String?

  schemaVersion Int   @default(2)
  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, offerId])
  @@index([accountId])
  @@index([offerId])
  @@index([status])
  @@index([validUntil])
}

model AccountPricingOverride {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  currency     String @default("GHS")
  priceMonthly Int?
  priceTermly  Int?
  priceYearly  Int?
  priceOneTime Int?

  licenseModelOverride    String?
  deploymentModeOverride  String?
  syncPolicyOverride      String?
  updatePolicyOverride    String?
  entitledVersionOverride String?

  discountType  String? // fixed | percentage | free
  discountValue Int?

  featureOverrides Json?
  limitOverrides   Json?

  validFrom  DateTime?
  validUntil DateTime?

  reason String?
  active Boolean @default(true)

  createdByUserId String?
  updatedByUserId String?

  schemaVersion Int   @default(2)
  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  changeOrders SubscriptionChangeOrder[]

  @@unique([accountId, planId])
  @@index([accountId])
  @@index([planId])
  @@index([active])
  @@index([validUntil])
}

model AccountQuotaEvent {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  resource  String // schools | branches | users | students | teachers | storageMb
  eventType String // warning | reached | blocked | released | reconciled
  operation String? // create | activate | restore | upload | sync_push

  tableName String?
  localId   String?
  cloudId   String?
  deviceId  String?

  currentUsage      Int
  limitValue        Int?
  requestedIncrease Int  @default(0)
  remainingBefore   Int?
  remainingAfter    Int?

  status  String  @default("open") // open | resolved | ignored
  message String?
  details Json?

  entitlementVersion Int @default(1)
  schemaVersion      Int @default(2)

  resolvedAt       DateTime?
  resolvedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([resource])
  @@index([eventType])
  @@index([status])
  @@index([tableName, localId])
  @@index([deviceId])
  @@index([createdAt])
}

model Invoice {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   AccountSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  perpetualLicenseId String?
  perpetualLicense   PerpetualLicense? @relation("PerpetualLicenseInvoices", fields: [perpetualLicenseId], references: [id], onDelete: SetNull)

  invoiceNumber String @unique
  currency      String @default("GHS")

  subtotal   Int
  discount   Int @default(0)
  tax        Int @default(0)
  total      Int
  amountPaid Int @default(0)
  balance    Int @default(0)

  status    String    @default("draft") // draft | issued | part_paid | paid | void | overdue | cancelled
  issueDate DateTime  @default(now())
  dueDate   DateTime?
  paidAt    DateTime?

  note     String?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments    AppPayment[]
  changeOrder SubscriptionChangeOrder? @relation("ChangeOrderInvoice")

  @@index([accountId])
  @@index([subscriptionId])
  @@index([perpetualLicenseId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
}

model AppPayment {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   AccountSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  perpetualLicenseId String?
  perpetualLicense   PerpetualLicense? @relation("PerpetualLicensePayments", fields: [perpetualLicenseId], references: [id], onDelete: SetNull)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  amount   Int
  currency String @default("GHS")

  method   String // momo | card | bank | cash | manual
  provider String? // paystack | hubtel | flutterwave | manual

  status String @default("pending") // pending | processing | paid | failed | refunded | cancelled

  providerReference String?
  accessCode        String?
  authorizationUrl  String?
  receiptNumber     String?
  payerName         String?
  payerPhone        String?
  payerEmail        String?

  paidAt      DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?
  note        String?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerEvents PaymentProviderEvent[]
  changeOrder    SubscriptionChangeOrder? @relation("ChangeOrderPayment")

  @@index([accountId])
  @@index([subscriptionId])
  @@index([perpetualLicenseId])
  @@index([invoiceId])
  @@index([status])
  @@index([method])
  @@index([provider])
  @@index([providerReference])
  @@index([paidAt])
}

model PaymentProviderEvent {
  id String @id @default(uuid())

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  paymentId String?
  payment   AppPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  provider          String // paystack | hubtel | flutterwave | manual
  eventType         String
  providerReference String?

  rawPayload  Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  error       String?

  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([paymentId])
  @@index([provider])
  @@index([eventType])
  @@index([providerReference])
  @@index([processed])
  @@index([createdAt])
}

model BillingEvent {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  type     String // subscription_created | payment_received | plan_changed | expired | suspended
  message  String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([type])
  @@index([createdAt])
}

// ======================================================
// OFFLINE PERPETUAL LICENSING
// ======================================================

model PerpetualLicense {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  licenseKeyHash   String @unique
  licenseKeyPrefix String
  status           String @default("pending") // pending | active | suspended | revoked | upgraded

  purchasedVersion     String
  entitledVersion      String
  licensedMajorVersion Int?

  maxSchools      Int?
  maxBranches     Int?
  maxUsers        Int?
  maxStudents     Int?
  maxTeachers     Int?
  deviceLimit     Int?
  activationLimit Int?

  syncPolicy   String @default("platform_only") // platform_only | disabled
  updatePolicy String @default("version_locked")

  requiresPeriodicValidation Boolean   @default(false)
  validationIntervalDays     Int?
  offlineGraceDays           Int?
  lastValidatedAt            DateTime?
  nextValidationAt           DateTime?

  currency       String @default("GHS")
  listAmount     Int
  discountAmount Int    @default(0)
  amountPaid     Int

  purchasedAt DateTime?
  activatedAt DateTime?
  suspendedAt DateTime?
  revokedAt   DateTime?
  upgradedAt  DateTime?

  privateOfferId    String?
  pricingOverrideId String?
  createdByUserId   String?
  metadata          Json?
  schemaVersion     Int     @default(2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activations         LicenseActivation[]
  devices             LicenseDevice[]
  versionEntitlements LicenseVersionEntitlement[]
  validationEvents    LicenseValidationEvent[]
  upgradeOffers       LicenseUpgradeOffer[]
  invoices            Invoice[]                   @relation("PerpetualLicenseInvoices")
  payments            AppPayment[]                @relation("PerpetualLicensePayments")
  entitlement         AccountEntitlement?

  @@index([accountId])
  @@index([planId])
  @@index([status])
  @@index([licenseKeyPrefix])
  @@index([entitledVersion])
  @@index([nextValidationAt])
  @@index([createdAt])
}

model LicenseActivation {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  licenseId String
  license   PerpetualLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  deviceId               String
  deviceName             String?
  platform               String?
  appVersion             String?
  machineFingerprintHash String?

  status        String    @default("active") // active | deactivated | revoked | replaced
  activatedAt   DateTime  @default(now())
  lastCheckedAt DateTime?
  deactivatedAt DateTime?
  revokedAt     DateTime?

  activationTokenHash String?
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([licenseId, deviceId])
  @@index([accountId])
  @@index([licenseId])
  @@index([deviceId])
  @@index([status])
  @@index([lastCheckedAt])
}

model LicenseDevice {
  id                     String           @id @default(uuid())
  accountId              String
  account                Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  licenseId              String
  license                PerpetualLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  deviceId               String
  deviceName             String?
  platform               String?
  appVersion             String?
  machineFingerprintHash String?
  status                 String           @default("active")
  firstSeenAt            DateTime         @default(now())
  lastSeenAt             DateTime?
  revokedAt              DateTime?
  metadata               Json?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@unique([licenseId, deviceId])
  @@index([accountId])
  @@index([licenseId])
  @@index([status])
  @@index([lastSeenAt])
}

model LicenseVersionEntitlement {
  id                String            @id @default(uuid())
  accountId         String
  account           Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  licenseId         String
  license           PerpetualLicense  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  planId            String?
  plan              SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  version           String
  majorVersion      Int?
  minimumAppVersion String?
  maximumAppVersion String?
  status            String            @default("active")
  grantedAt         DateTime          @default(now())
  expiresAt         DateTime?
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([licenseId, version])
  @@index([accountId])
  @@index([planId])
  @@index([status])
  @@index([expiresAt])
}

model LicenseValidationEvent {
  id String @id @default(uuid())

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  licenseId String
  license   PerpetualLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  activationId String?
  deviceId     String?
  appVersion   String?
  result       String // valid | grace | version_blocked | device_blocked | suspended | revoked | failed
  message      String?
  details      Json?
  validatedAt  DateTime @default(now())

  @@index([licenseId])
  @@index([activationId])
  @@index([deviceId])
  @@index([result])
  @@index([validatedAt])
}

model LicenseUpgradeOffer {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  licenseId String
  license   PerpetualLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  fromPlanId String?
  fromPlan   SubscriptionPlan? @relation("LicenseUpgradeFromPlan", fields: [fromPlanId], references: [id], onDelete: SetNull)

  toPlanId String
  toPlan   SubscriptionPlan @relation("LicenseUpgradeToPlan", fields: [toPlanId], references: [id])

  upgradeType String // version | capacity | device_limit | connected_migration
  fromVersion String?
  toVersion   String?
  oldLimits   Json?
  newLimits   Json?

  currency       String @default("GHS")
  baseAmount     Int
  discountAmount Int    @default(0)
  creditAmount   Int    @default(0)
  taxAmount      Int    @default(0)
  amountDue      Int

  status         String    @default("quoted") // quoted | payment_pending | paid | applied | cancelled | expired | failed
  calculation    Json
  quoteExpiresAt DateTime
  paidAt         DateTime?
  appliedAt      DateTime?
  failureReason  String?

  invoiceId         String? @unique
  paymentId         String? @unique
  requestedByUserId String?
  appliedByUserId   String?
  metadata          Json?
  schemaVersion     Int     @default(2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([licenseId])
  @@index([fromPlanId])
  @@index([toPlanId])
  @@index([upgradeType])
  @@index([status])
  @@index([quoteExpiresAt])
}

// ======================================================
// PLATFORM RELEASES, DEVELOPER NOTICES AND FEEDBACK
// ======================================================

model PlatformRelease {
  id String @id @default(uuid())

  version           String    @unique
  majorVersion      Int?
  title             String
  summary           String?
  releaseNotes      Json?
  status            String    @default("draft") // draft | scheduled | published | withdrawn
  channel           String    @default("stable") // stable | preview | security
  minimumAppVersion String?
  publishedAt       DateTime?
  createdByUserId   String?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  announcements PlatformAnnouncement[]

  @@index([majorVersion])
  @@index([status])
  @@index([channel])
  @@index([publishedAt])
}

model PlatformAnnouncement {
  id String @id @default(uuid())

  releaseId String?
  release   PlatformRelease? @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  type     String @default("general") // general | update | maintenance | security | billing | migration
  priority String @default("normal") // low | normal | high | critical
  status   String @default("draft") // draft | scheduled | published | expired | withdrawn

  titleKey     String?
  bodyKey      String?
  defaultTitle String
  defaultBody  String
  translations Json?

  actionLabelKey String?
  actionUrl      String?
  actionType     String? // internal_route | external_url | upgrade | support

  audience                Json? // account/plan/role/country/locale/version/deployment filters
  dismissible             Boolean @default(true)
  requiresAcknowledgement Boolean @default(false)

  startsAt        DateTime?
  expiresAt       DateTime?
  publishedAt     DateTime?
  createdByUserId String?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  receipts PlatformAnnouncementReceipt[]

  @@index([releaseId])
  @@index([type])
  @@index([priority])
  @@index([status])
  @@index([startsAt])
  @@index([expiresAt])
  @@index([publishedAt])
}

model PlatformAnnouncementReceipt {
  id String @id @default(uuid())

  announcementId String
  announcement   PlatformAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  userId       String?
  membershipId String?
  deviceId     String?

  deliveredAt    DateTime?
  seenAt         DateTime?
  acknowledgedAt DateTime?
  dismissedAt    DateTime?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([announcementId, accountId, userId, membershipId])
  @@index([announcementId])
  @@index([accountId])
  @@index([userId])
  @@index([membershipId])
  @@index([deviceId])
  @@index([seenAt])
  @@index([acknowledgedAt])
}

model PlatformFeedback {
  id String @id @default(uuid())

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  schoolId                String?
  branchId                String?
  submittedByUserId       String?
  submittedByMembershipId String?
  submittedByName         String?
  submittedByEmail        String?

  type     String // suggestion | complaint | bug | support_request | feature_request | billing_question | general
  category String?
  priority String  @default("normal")
  status   String  @default("submitted") // submitted | acknowledged | under_review | planned | in_progress | resolved | closed

  subject           String
  description       String
  locale            String?
  appVersion        String?
  deviceId          String?
  pageRoute         String?
  attachments       Json?
  diagnosticContext Json?

  assignedToUserId String?
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  resolutionNote   String?
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  messages     PlatformFeedbackMessage[]
  statusEvents PlatformFeedbackStatusEvent[]

  @@index([accountId])
  @@index([schoolId, branchId])
  @@index([submittedByUserId])
  @@index([type])
  @@index([priority])
  @@index([status])
  @@index([assignedToUserId])
  @@index([createdAt])
}

model PlatformFeedbackMessage {
  id String @id @default(uuid())

  feedbackId String
  feedback   PlatformFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  authorType   String // customer | platform_team | system
  authorUserId String?
  body         String
  attachments  Json?
  internal     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([feedbackId])
  @@index([authorUserId])
  @@index([internal])
  @@index([createdAt])
}

model PlatformFeedbackStatusEvent {
  id String @id @default(uuid())

  feedbackId String
  feedback   PlatformFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  fromStatus      String?
  toStatus        String
  changedByUserId String?
  note            String?
  createdAt       DateTime @default(now())

  @@index([feedbackId])
  @@index([toStatus])
  @@index([changedByUserId])
  @@index([createdAt])
}

// ======================================================
// SUPPORTED LOCALES AND TRANSLATED PLATFORM CONTENT
// ======================================================

model SupportedLocale {
  id String @id @default(uuid())

  code                String   @unique // en-GH | fr-FR | fr-CI
  language            String
  region              String?
  nativeName          String
  englishName         String
  direction           String   @default("ltr") // ltr | rtl
  fallbackCode        String?
  active              Boolean  @default(true)
  public              Boolean  @default(false)
  completenessPercent Int      @default(0)
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([language])
  @@index([region])
  @@index([active])
  @@index([public])
}

// ======================================================
// PLATFORM API / INTEGRATIONS
// ======================================================

model ApiClient {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name        String
  description String?
  clientType  String  @default("internal") // internal | partner | school_app | learn_app | business_app | external

  allowedOrigins Json?
  allowedIps     Json?
  scopes         Json?

  active     Boolean   @default(true)
  lastUsedAt DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  apiKeys  ApiKey[]
  webhooks Webhook[]

  @@index([accountId])
  @@index([clientType])
  @@index([active])
  @@index([lastUsedAt])
}

model ApiKey {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  clientId String
  client   ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name      String
  keyPrefix String
  keyHash   String @unique
  scopes    Json?

  active          Boolean   @default(true)
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  revokedByUserId String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId])
  @@index([clientId])
  @@index([keyPrefix])
  @@index([active])
  @@index([expiresAt])
  @@index([lastUsedAt])
}

model Webhook {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  clientId String?
  client   ApiClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  name       String
  url        String
  secretHash String?

  events Json // e.g. ["student.created", "payment.paid", "report.published"]
  active Boolean @default(true)

  maxRetries      Int       @default(3)
  timeoutSeconds  Int       @default(20)
  lastTriggeredAt DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  logs WebhookLog[]

  @@index([accountId])
  @@index([clientId])
  @@index([active])
  @@index([lastTriggeredAt])
}

model WebhookLog {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  webhookId String?
  webhook   Webhook? @relation(fields: [webhookId], references: [id], onDelete: SetNull)

  eventType      String
  targetUrl      String
  requestPayload Json?
  responseStatus Int?
  responseBody   String?
  error          String?

  attempt     Int       @default(1)
  status      String    @default("pending") // pending | success | failed | retrying
  deliveredAt DateTime?
  nextRetryAt DateTime?

  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([webhookId])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
  @@index([nextRetryAt])
}

model IntegrationMapping {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  sourceSystem String // schools | learn | business | external
  targetSystem String // schools | learn | business | external

  entityType String // student | teacher | class | subject | classSubject | course | enrollment | assessment

  localTable   String?
  localId      String?
  localCloudId String?

  externalId  String
  externalRef String?
  metadata    Json?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, sourceSystem, targetSystem, entityType, externalId])
  @@index([accountId])
  @@index([sourceSystem])
  @@index([targetSystem])
  @@index([entityType])
  @@index([localTable, localId])
  @@index([localCloudId])
  @@index([active])
}

// ======================================================
// AUDIT / SECURITY / OPERATIONS
// ======================================================

model AuditLog {
  id String @id @default(uuid())

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  actorUserId String?
  actorEmail  String?
  actorRole   String?

  action     String // create | update | delete | login | logout | export | import | publish | approve | pay | sync
  moduleKey  String?
  entityType String?
  entityId   String?

  schoolId String?
  branchId String?

  before   Json?
  after    Json?
  metadata Json?

  ipAddress String?
  userAgent String?
  deviceId  String?

  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([actorUserId])
  @@index([action])
  @@index([moduleKey])
  @@index([entityType, entityId])
  @@index([schoolId, branchId])
  @@index([createdAt])
}

model BackgroundJob {
  id String @id @default(uuid())

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  type     String // sync_push | sync_pull | report_generation | payment_verify | webhook_dispatch | backup | import | export
  status   String @default("queued") // queued | running | completed | failed | cancelled
  priority Int    @default(5)

  payload Json?
  result  Json?
  error   String?

  attempts    Int @default(0)
  maxAttempts Int @default(3)

  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId])
  @@index([type])
  @@index([status])
  @@index([priority])
  @@index([scheduledAt])
  @@index([createdAt])
}

model StorageUsage {
  id String @id @default(uuid())

  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  usedBytes BigInt @default(0)
  usedMb    Int    @default(0)
  limitMb   Int?

  imageBytes    BigInt @default(0)
  documentBytes BigInt @default(0)
  backupBytes   BigInt @default(0)
  otherBytes    BigInt @default(0)

  lastCalculatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([usedMb])
  @@index([limitMb])
}

model AccountFeatureFlag {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  key         String
  enabled     Boolean @default(false)
  value       Json?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, key])
  @@index([accountId])
  @@index([key])
  @@index([enabled])
}

model AccountSystemSetting {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  key         String
  value       Json
  description String?
  locked      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, key])
  @@index([accountId])
  @@index([key])
  @@index([locked])
}

// ======================================================
// COMMUNICATION DELIVERY LOGS
// ======================================================

model NotificationDeliveryLog {
  id String @id @default(uuid())

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  schoolId String?
  branchId String?

  channel String // in_app | sms | email | whatsapp | push
  purpose String // announcement | message | fee_reminder | payroll | attendance | report | custom

  recipientUserId String?
  recipientType   String?
  recipientId     String?
  recipientName   String?
  recipientPhone  String?
  recipientEmail  String?

  subject String?
  body    String?

  status            String  @default("queued") // queued | sent | delivered | read | failed
  provider          String?
  providerReference String?

  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  failedAt     DateTime?
  failedReason String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([schoolId, branchId])
  @@index([channel])
  @@index([purpose])
  @@index([recipientUserId])
  @@index([recipientType, recipientId])
  @@index([status])
  @@index([providerReference])
  @@index([createdAt])
}
